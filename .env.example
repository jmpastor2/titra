# Copia este archivo a .env.local y rellena con los valores de tu proyecto Supabase
# (Project Settings → API). La anon key es pública por diseño; NUNCA pongas aquí la service_role.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
# Clave pública VAPID para los avisos push (npx web-push generate-vapid-keys). La privada va
# solo en los secretos de la Edge Function; ver docs/notificaciones.md.
VITE_VAPID_PUBLIC_KEY=

# Opcional: ruta base de despliegue. Por defecto /titra/ en producción (GitHub Pages) y / en dev.
# VITE_BASE_PATH=/
